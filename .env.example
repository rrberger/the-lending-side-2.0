# Cloudflare R2 Credentials for Local CMS Image Uploads
# ----------------------------------------------------
# 1. Access Key ID from Cloudflare R2 API Tokens (Read/Write)
R2_ACCESS_KEY_ID=your_access_key_id_here

# 2. Secret Access Key from Cloudflare R2 API Tokens
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# 3. Cloudflare R2 S3 Endpoint URL (find this in R2 panel, e.g., https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# 4. R2 Bucket Name (default: the-lending-side-media)
R2_BUCKET_NAME=the-lending-side-media

# 5. Public Custom Domain mapped to your R2 bucket (e.g., https://media.thelendingside.com)
# Leave blank to fallback to Cloudflare's default public endpoint
#R2_PUBLIC_CUSTOM_DOMAIN=https://media.thelendingside.com